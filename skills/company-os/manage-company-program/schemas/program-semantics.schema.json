{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-os.program-semantics.v1",
  "title": "Company OS Program Semantics Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schema_version",
    "program_id",
    "program_label",
    "canonical_terms",
    "constants",
    "authority_states",
    "prohibitions",
    "evidence_requirements",
    "artifact_oracles",
    "required_capabilities"
  ],
  "properties": {
    "$schema": {"type": "string", "const": "https://json-schema.org/draft/2020-12/schema"},
    "$id": {"type": "string", "const": "company-os.program-semantics.v1"},
    "schema_version": {"type": "integer", "const": 1},
    "program_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
    "program_label": {"type": "string", "minLength": 1},
    "canonical_terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term_id", "label", "aliases", "prohibited_aliases"],
        "properties": {
          "term_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
          "label": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "prohibited_aliases": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "constants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constant_id", "label", "type", "value", "unit", "row_map"],
        "properties": {
          "constant_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
          "label": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["integer", "string", "boolean"]},
          "value": {"type": ["integer", "string", "boolean"]},
          "unit": {"type": "string", "pattern": "^[a-z][a-z0-9_/-]*$"},
          "row_map": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]*$"}
        }
      }
    },
    "authority_states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state_id", "label", "kind", "delegable", "delegated_states", "allowed_actions"],
        "properties": {
          "state_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
          "label": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["manager", "worker"]},
          "delegable": {"type": "boolean"},
          "delegated_states": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"}},
          "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "prohibitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prohibition_id", "label", "applies_to"],
        "properties": {
          "prohibition_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
          "label": {"type": "string", "minLength": 1},
          "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["manager", "worker", "both"]}}
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "claim", "required", "citation_required", "minimum_citations"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
          "claim": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "citation_required": {"type": "boolean"},
          "minimum_citations": {"type": "integer", "minimum": 1}
        }
      }
    },
    "artifact_oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["oracle_id", "label", "kind", "normalization", "rule", "required"],
        "properties": {
          "oracle_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
          "label": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["text", "json"]},
          "normalization": {"type": "string", "const": "unicode-nfc-strip"},
          "rule": {"type": "string", "const": "normalized-nonempty"},
          "required": {"type": "boolean"}
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "required"],
        "properties": {
          "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
          "required": {"type": "boolean"}
        }
      }
    }
  }
}
