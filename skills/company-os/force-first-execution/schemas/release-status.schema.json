{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-os.release-status.v1",
  "title": "Company OS Release Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "program_id", "program_version", "definition_version", "cycle_id", "scope_contract_sha256", "deliverables"],
  "properties": {
    "schema": {"const": "company-os.release-status.v1"},
    "project_id": {"$ref": "#/$defs/id"},
    "program_id": {"$ref": "#/$defs/id"},
    "program_version": {"type": "integer", "minimum": 1},
    "definition_version": {"type": "integer", "minimum": 1},
    "cycle_id": {"$ref": "#/$defs/id"},
    "scope_contract_sha256": {"$ref": "#/$defs/sha256"},
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deliverable_id", "disposition", "attempt_chains", "rework_cycles", "evidence"],
        "properties": {
          "deliverable_id": {"$ref": "#/$defs/id"},
          "disposition": {"enum": ["accepted", "rejected"]},
          "attempt_chains": {"type": "integer", "minimum": 1},
          "rework_cycles": {"type": "integer", "minimum": 0},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["terminal_receipts"],
            "properties": {
              "terminal_receipts": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/file"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
