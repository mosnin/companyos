{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-os.release-scope-admission-verification.v1",
  "title": "Company OS Release Scope Admission Verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "project_id", "program_id", "program_version", "definition_version", "cycle_id", "admission_verification_path", "scope_definition_sha256", "scope_contract_sha256", "registry_record_sha256", "scope_admission", "accepted_design_decision", "master_public_key_sha256"],
  "properties": {
    "schema": {"const": "company-os.release-scope-admission-verification.v1"},
    "ok": {"const": true},
    "project_id": {"$ref": "#/$defs/id"},
    "program_id": {"$ref": "#/$defs/id"},
    "program_version": {"type": "integer", "minimum": 1},
    "definition_version": {"type": "integer", "minimum": 1},
    "cycle_id": {"$ref": "#/$defs/id"},
    "admission_verification_path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "scope_definition_sha256": {"$ref": "#/$defs/sha256"},
    "scope_contract_sha256": {"$ref": "#/$defs/sha256"},
    "registry_record_sha256": {"$ref": "#/$defs/sha256"},
    "scope_admission": {"$ref": "#/$defs/file"},
    "accepted_design_decision": {"$ref": "#/$defs/file"},
    "master_public_key_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
