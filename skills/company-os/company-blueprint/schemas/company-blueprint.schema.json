{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-os.company-blueprint.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "blueprint_version", "company_id", "execution_ready", "identity", "market", "objectives", "operating_model", "authority", "brand", "knowledge", "assets", "integrations", "storage", "cadence", "unknowns"],
  "properties": {
    "$schema": {"const": "company-os.company-blueprint.v1"},
    "blueprint_version": {"type": "integer", "minimum": 1},
    "company_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "execution_ready": {"const": true},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "operating_name", "mission", "thesis", "values"],
      "properties": {
        "legal_name": {"type": "string", "minLength": 1},
        "operating_name": {"type": "string", "minLength": 1},
        "mission": {"type": "string", "minLength": 1},
        "thesis": {"type": "string", "minLength": 1},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_segments", "problems", "offers"],
      "properties": {
        "customer_segments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "problems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "offers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "metric", "baseline", "target", "horizon", "priority"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "outcome": {"type": "string", "minLength": 1},
          "metric": {"type": "string", "minLength": 1},
          "baseline": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "horizon": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 1}
        }
      }
    },
    "operating_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetypes", "requested_capabilities", "department_overrides"],
      "properties": {
        "archetypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "requested_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}},
        "department_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["department_id", "enabled", "reason"],
            "properties": {
              "department_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
              "enabled": {"type": "boolean"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_required", "prohibited_actions"],
      "properties": {
        "approval_required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prohibited_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principles", "references"],
      "properties": {
        "principles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "references": {"type": "array"}
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classifications", "retention_policy", "sources"],
      "properties": {
        "classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "retention_policy": {"type": "string", "minLength": 1},
        "sources": {"type": "array"}
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "locator"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "kind": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "locator", "permission_mode"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "kind": {"enum": ["mcp", "plugin", "api", "repository", "database", "filesystem", "human"]},
          "locator": {"type": "string", "minLength": 1},
          "permission_mode": {"enum": ["read_only", "proposal_only", "approved_write", "unavailable"]},
          "credential_reference": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "dsn_env", "schema"],
      "properties": {
        "adapter": {"const": "postgresql"},
        "dsn_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "schema": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daily", "weekly", "monthly"],
      "properties": {
        "daily": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "weekly": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "monthly": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "blocking", "owner", "resolution"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "question": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "owner": {"type": "string", "minLength": 1},
          "resolution": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
