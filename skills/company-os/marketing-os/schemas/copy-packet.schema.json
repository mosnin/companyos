{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-os.marketing-copy-packet.v1",
  "title": "Company OS Marketing Copy Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "packet_id", "brief_digest", "format", "body",
    "claims", "cta", "voice_check"
  ],
  "properties": {
    "$schema": {"const": "company-os.marketing-copy-packet.v1"},
    "packet_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "brief_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "format": {"enum": ["linkedin-post", "email-sequence", "landing-page", "ad-copy", "other"]},
    "body": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "source"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "cta": {"type": "string", "minLength": 1},
    "voice_check": {"type": "string", "minLength": 1}
  }
}
