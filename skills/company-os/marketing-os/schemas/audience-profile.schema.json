{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-os.marketing-audience-profile.v1",
  "title": "Company OS Marketing Audience Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "profile_id", "subject", "job", "primary_pain",
    "voice_of_customer", "alternatives", "sources", "confidence", "gaps"
  ],
  "properties": {
    "$schema": {"const": "company-os.marketing-audience-profile.v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "subject": {"type": "string", "minLength": 1},
    "job": {"type": "string", "minLength": 1},
    "primary_pain": {"type": "string", "minLength": 1},
    "voice_of_customer": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "source"],
        "properties": {
          "quote": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "alternatives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "gaps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
