{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.companyos.sh/contracts/kernel-v1.schema.json",
  "title": "Company OS Kernel v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "status",
    "companyOS",
    "entrypoints",
    "dependencies",
    "dataSchemaVersion",
    "permissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "pattern": "^@mosnin/[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": [
        "ready",
        "draft"
      ]
    },
    "companyOS": {
      "type": "string",
      "description": "Stable exact, caret, tilde, or >=x.y.z <x.y.z. Validator enforces host compatibility."
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "description": "Exact stable version. Keys are kernel ids."
      }
    },
    "dataSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "permissions": {
      "const": []
    }
  }
}
